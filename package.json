{
  "name": "loom-electron-host-ui",
  "version": "0.1.1",
  "private": true,
  "description": "Electron + React host interface for the Loom Real-Time Monitoring Program.",
  "author": "Smit SHA Textile Machinery",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "vite build",
    "start": "electron .",
    "dist": "npm run build && electron-builder --win portable",
    "dist:dir": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "vite": "latest",
    "typescript": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "electron": "^41.3.0",
    "electron-builder": "latest",
    "concurrently": "latest",
    "wait-on": "latest"
  },
  "build": {
    "appId": "com.smit.loom.host",
    "productName": "Loom Real-Time Monitoring Panel",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "LoomHostMonitoring-${version}.${ext}"
    },
    "extraResources": [
      {
        "from": "backend",
        "to": "backend"
      },
      {
        "from": "public/2FAST_100px.png",
        "to": "public/2FAST_100px.png"
      }
    ]
  }
}
